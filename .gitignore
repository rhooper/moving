# Runtime data — the database and photos are backed up separately, not versioned
var/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Worktrees (work discipline: feature work is isolated here).
# .claude/worktrees is where the native EnterWorktree tool places them; without
# this the whole worktree tree shows up as untracked in the main checkout.
.worktrees/
.claude/worktrees/

# macOS
.DS_Store

# Local secrets, and local settings (see moving.example.toml)
.env
moving.toml
node_modules/
