{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(./.env.*)",
      "Read(**/.env.*)",
      "Read(**/secrets.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(head .env)",
      "Bash(head ./.env)",
      "Bash(tail .env)",
      "Bash(tail ./.env)",
      "Bash(less .env)",
      "Bash(more .env)",
      "Bash(grep * .env)",
      "Bash(source .env)",
      "Bash(. .env)",
      "Bash(security find-generic-password:*)",
      "Bash(op read:*)",
      "Bash(op item get:*)"
    ]
  }
}
