# Local settings for the moving box tracker. Copy to `.env` in this directory,
# fill in the value and `chmod 600 .env`. Git ignores `.env` (see .gitignore,
# "Local secrets"); backups copy the database only, and exports carry database
# contents, not files -- so a key here stays out of all three.
#
# With no key the app still works: photos are read by the local Ollama model
# instead of Claude. That is a supported configuration, not a broken one.

ANTHROPIC_API_KEY=
